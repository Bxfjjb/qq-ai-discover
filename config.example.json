{
  "version": 2,
  "enabled": true,
  "channels": ["qq_xxxxxxxxxxxx"],
  "groupVerify": false,
  "groupPolicy": "inject",
  "crossChatVerify": true,
  "identities": {},
  "pairing": {
    "enabled": true,
    "ttlMs": 600000,
    "maxFails": 5,
    "pairAskText": "配对码：{code}\n10 分钟内在群里 @ 我 说「配对 {code}」，就记住你了～",
    "pairOkText": "唔，记住啦～之后会好好回应你的",
    "pairBadText": "码不对喔…回私聊重新要一个吧",
    "pairExpiredText": "配对码过期了，回私聊跟我说「配对」再要一个吧～",
    "pairNeedVerifyText": "要先在私聊里认过主，才能给你配对码喔"
  },
  "strictVerify": false,
  "caseSensitive": true,
  "strictPunctuation": true,
  "maxFailures": 3,
  "cooldownMs": 1800000,
  "successText": "唔…主人？我在的喔(๑>ᴗ<๑)",
  "challengeText": "唔…要先对暗号喔",
  "mismatchText": "不对喔…再想想？",
  "lockedText": "现在不理你了喔…过一会儿再来吧。",
  "refusalText": "唔…这个不能说喔，我们聊点别的吧～",
  "passphrase": { "env": "YOUZI_PASSPHRASE", "file": "passphrase.sha256", "sha256": "" },
  "whiteList": { "source": "channels.json", "file": "", "extra": {}, "inline": [] },
  "state": { "file": "state.json" },
  "log": { "file": "attempts.jsonl", "maxBytes": 4194304, "rawIds": true },
  "notify": { "owner": true, "prefix": "【身份闸门告警】" },
  "inject": { "enabled": true }
}
